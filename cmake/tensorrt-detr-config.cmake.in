# TensorRT-DETRConfig.cmake.in
# - This file is generated by CMake and should not be edited manually.

# Set the package version
set(TensorRT-DETR_VERSION "@PACKAGE_VERSION@")

# Set the root directory of the package
set(TensorRT-DETR_DIRS "@PACKAGE_DIRS@")

# Set the include directory
set(TensorRT-DETR_INCLUDE_DIRS "@PACKAGE_INCLUDE_DIRS@")

# Set the library directory
set(TensorRT-DETR_LIBRARY_DIRS "@PACKAGE_LIBRARY_DIRS@")

# Set the library dependencies
set(TensorRT-DETR_LIBs "@PACKAGE_LIBRARIES@")

# Add the library directories to the linker
link_directories("${TensorRT-DETR_LIBRARY_DIRS}")

# Print the found information
message(STATUS "Found TensorRT-DETR: ${TensorRT-DETR_DIRS} (found version \"${TensorRT-DETR_VERSION}\")")