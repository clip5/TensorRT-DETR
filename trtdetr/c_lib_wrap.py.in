#!/usr/bin/env python
# -*-coding:utf-8 -*-
# ==============================================================================
# File    :   c_lib_wrap.py
# Desc    :   Locate and load CUDA/TensorRT-dependent Python extension modules.
# ==============================================================================
import os
import sys

if os.name == "nt":
    need_lib_dirs = [r"${CUDAToolkit_BIN_DIR}", r"${TRT_LIB_DIR}"]
    for need_lib_dir in need_lib_dirs:
        sys.path.insert(0, need_lib_dir)
        if sys.version_info[:2] >= (3, 8):
            os.add_dll_directory(need_lib_dir)

try:
    from .libs.py_trtdetr import *
except Exception as e:
    raise RuntimeError(f"py_trtdetr initialization failed! Error: {e}")
